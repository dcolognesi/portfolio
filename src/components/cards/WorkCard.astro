---
import Icon from '../Icon.astro';
import Artwork from '../art/Artwork.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** The first card can load with the initial viewport. */
  eager?: boolean;
  class?: string;
}

const { project, eager = false, class: className } = Astro.props;
const { title, excerpt, year, category, image, hero, artwork } = project.data;
/** Prefer the case-study hero for cards when one is defined. */
const cardImage = hero ?? image;
---

<a
  class:list={['work-card', className]}
  href={`/work/${project.id}/`}
  data-category={category}
>
  <div class="work-media">
    <span class="work-year">{year}</span>
    {
      cardImage ? (
        <img
          src={cardImage.src}
          alt={cardImage.alt}
          width={cardImage.width}
          height={cardImage.height}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={eager ? 'high' : 'low'}
          style={cardImage.position ? `object-position:${cardImage.position}` : undefined}
        />
      ) : artwork ? (
        <Artwork name={artwork} label={`${title} — project artwork`} />
      ) : null
    }
  </div>
  <div class="work-body">
    <div>
      <h3>{title}</h3>
      <span>{excerpt}</span>
    </div>
    <span class="work-go"><Icon name="arrow" class="ic-sm" /></span>
  </div>
</a>
