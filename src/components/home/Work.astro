---
import Button from '../Button.astro';
import SectionHeading from '../SectionHeading.astro';
import WorkCard from '../cards/WorkCard.astro';
import { workHeading } from '~/data/highlights';
import { getCollection } from 'astro:content';
import { isVisible } from '~/lib/utils';

/* Only featured projects reach the homepage. Everything lives on /work. */
const projects = (await getCollection('projects'))
  .filter(isVisible)
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="wrap sec" id="work" aria-labelledby="work-h">
  <SectionHeading eyebrow={workHeading.eyebrow} title={workHeading.title} id="work-h">
    <Button href="/work/" variant="ink">View all projects</Button>
  </SectionHeading>

  <div class="work-grid">
    {
      projects.map((project) => (
        <WorkCard project={project} />
      ))
    }
  </div>
</section>
