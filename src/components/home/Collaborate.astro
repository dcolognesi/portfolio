---
import Icon from '../Icon.astro';
import { collaborate } from '~/data/highlights';
---

<section class="wrap sec collab-sec" aria-labelledby="collab-h">
  <div class="collab-grid">
    <div class="collab-visual rev">
      <div class="mocks">
        {
          collaborate.images.map((image, i) => (
            <div class:list={['mock', i === 0 ? 'mock-a' : 'mock-b']}>
              <img
                src={image.src}
                alt={image.alt}
                width={image.width}
                height={image.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))
        }
        <a class="collab-arrow" href="/work/" aria-label="View selected projects">
          <Icon name="arrow" class="ic-sm" />
        </a>
      </div>
    </div>

    <div class="collab-copy rev rev-d1">
      <p class="eyebrow">{collaborate.eyebrow}</p>
      <h2 class="d2 collab-h" id="collab-h">{collaborate.title}</h2>
      <p class="collab-sub">{collaborate.body}</p>
    </div>
  </div>
</section>
