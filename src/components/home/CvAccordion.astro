---
import Icon from '../Icon.astro';
import { cvHeading } from '~/data/cv';
import { experience, experienceHeading } from '~/data/experience';
import { education, educationHeading } from '~/data/education';
---

<section class="wrap sec" id="cv" aria-labelledby="cv-h">
  <div class="cv-head rev">
    <p class="eyebrow">{cvHeading.eyebrow}</p>
    <h2 class="d2" id="cv-h">{cvHeading.title}</h2>
    <p class="lead">{cvHeading.intro}</p>
  </div>

  <details class="cv-acc rev">
    <summary class="cv-toggle">
      <span class="cv-toggle-open">Open the full CV</span>
      <span class="cv-toggle-close">Close the CV</span>
      <span class="cv-toggle-ic" aria-hidden="true">
        <Icon name="plus" class="ic-sm" />
      </span>
    </summary>

    <div class="cv-body">
      <section class="cv-block" id="experience" aria-labelledby="cv-exp">
        <h3 id="cv-exp">{experienceHeading.title}</h3>
        <ol class="timeline-list">
          {
            experience.map((item) => (
              <li class="timeline-item">
                <div class="timeline-meta">
                  <span class="timeline-period">
                    {item.start} — {item.end}
                  </span>
                  {item.location && <span class="timeline-loc">{item.location}</span>}
                </div>

                <div class="timeline-body">
                  <h4>{item.role}</h4>
                  <p class="timeline-org">{item.company}</p>
                  <p>{item.summary}</p>

                  {item.highlights && item.highlights.length > 0 && (
                    <ul class="timeline-points">
                      {item.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  )}

                  {item.tags && item.tags.length > 0 && (
                    <ul class="timeline-tags" aria-label="Skills">
                      {item.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="cv-block" id="education" aria-labelledby="cv-edu">
        <h3 id="cv-edu">{educationHeading.title}</h3>
        <ol class="timeline-list">
          {
            education.map((item) => (
              <li class="timeline-item">
                <div class="timeline-meta">
                  <span class="timeline-period">
                    {item.start} — {item.end}
                  </span>
                  {item.location && <span class="timeline-loc">{item.location}</span>}
                </div>

                <div class="timeline-body">
                  <h4>{item.qualification}</h4>
                  <p class="timeline-org">{item.institution}</p>
                  {item.summary && <p>{item.summary}</p>}

                  {item.highlights && item.highlights.length > 0 && (
                    <ul class="timeline-points">
                      {item.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

    </div>
  </details>
</section>

<script>
  const accordion = document.querySelector<HTMLDetailsElement>('.cv-acc');
  const hashes = ['#cv', '#experience', '#education'];
  const hash = window.location.hash;
  const openForHash = (value: string) => {
    if (accordion && hashes.includes(value)) accordion.open = true;
  };

  openForHash(hash);
  if (accordion?.open) {
    requestAnimationFrame(() => document.querySelector(hash)?.scrollIntoView({ block: 'start' }));
  }

  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest('a');
    const href = link?.getAttribute('href');
    if (href?.startsWith('#')) openForHash(href);
  });
</script>
