---
import PageLayout from '~/layouts/PageLayout.astro';
import siteConfig from '~/config/site';
import { breadcrumbSchema, graph, webPageSchema, websiteSchema } from '~/lib/jsonld';

const updated = 'Last updated: October 2026.';
const privacyUrl = `${siteConfig.url}/privacy/`;
const privacyDescription = `How ${siteConfig.name} handles visitor data.`;

const jsonLd = graph([
  websiteSchema(siteConfig),
  webPageSchema(siteConfig, {
    url: privacyUrl,
    name: 'Privacy',
    description: privacyDescription,
  }),
  breadcrumbSchema([
    { name: 'Home', url: `${siteConfig.url}/` },
    { name: 'Privacy', url: privacyUrl },
  ]),
]);
---

<PageLayout
  title="Privacy"
  heading="Privacy"
  eyebrow="Legal"
  intro="How this site handles visitor data."
  description={privacyDescription}
  crumbs={[{ label: 'Privacy' }]}
  jsonLd={jsonLd}
>
  <section class="wrap sec" style="padding-top:0">
    <div class="prose rev">
      <h2>What this site collects</h2>
      <p>
        This is a static site. It sets no cookies, runs no analytics and loads no third-party
        tracking scripts. Fonts are served from this domain.
      </p>

      <h2>Server logs</h2>
      <p>
        The hosting provider may keep standard access logs such as IP address, user agent,
        requested URL and timestamp. Those records are kept under the provider's retention
        policy.
      </p>

      <h2>Contact by email</h2>
      <p>
        If you send an email, the message and the address you use are processed only to reply
        to your enquiry. They are not added to a mailing list or shared for marketing.
      </p>

      <h2>External links</h2>
      <p>
        Links to LinkedIn and GitHub open external services with their own privacy policies.
        Visiting those services is subject to their terms.
      </p>

      <h2>Getting in touch</h2>
      <p>
        Questions about this page can go to
        <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>.
      </p>

      <p class="mini muted">{updated}</p>
    </div>
  </section>
</PageLayout>
