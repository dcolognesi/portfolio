---
export const prerender = true;
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ImageZoom from 'astro-image-zoom/ImageZoom.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Artwork from '~/components/art/Artwork.astro';
import Button from '~/components/Button.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { isVisible } from '~/lib/utils';
import { graph, breadcrumbSchema, personSchema, projectSchema } from '~/lib/jsonld';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects'))
    .filter(isVisible)
    .sort((a, b) => a.data.order - b.data.order);

  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;

/** The case-study hero can override the listing image. */
const hero = d.hero ?? d.image;

const projectUrl = `${siteConfig.url}/work/${project.id}/`;

const jsonLd = graph([
  personSchema(siteConfig),
  projectSchema(siteConfig, {
    title: d.title,
    description: d.description,
    url: projectUrl,
    image: hero?.src,
    category: d.category,
    keywords: [...d.services, ...d.technologies],
    datePublished: d.year,
  }),
  breadcrumbSchema([
    { name: 'Home', url: `${siteConfig.url}/` },
    { name: 'Projects', url: `${siteConfig.url}/work/` },
    { name: d.title, url: projectUrl },
  ]),
]);
---

<BaseLayout
  title={d.title}
  description={d.description}
  image={hero?.src}
  imageAlt={hero?.alt}
  jsonLd={jsonLd}
>
  <article>
    <section class="wrap phero">
      <div class="rev">
        <Breadcrumbs items={[{ label: 'Projects', href: '/work/' }, { label: d.title }]} />
        <p class="eyebrow">{d.category} &middot; {d.year}</p>
        <h1 class="d1 case-title">{d.title}</h1>
        <p class="lead case-lead">{d.description}</p>
      </div>
    </section>

    <section class="wrap" style="padding-bottom:var(--sec)">
      <ImageZoom>
        <div class:list={['case-media rev', hero?.fit === 'contain' && 'case-media-contain']}>
          {
            hero ? (
              <img
                src={hero.src}
                alt={hero.alt}
                width={hero.width}
                height={hero.height}
                fetchpriority="high"
                decoding="async"
              />
            ) : d.artwork ? (
              <Artwork name={d.artwork} label={`${d.title} — project artwork`} />
            ) : null
          }
        </div>
      </ImageZoom>

      <div class="case-grid">
        <div class="rev">
          <ImageZoom>
            <div class="prose"><Content /></div>
          </ImageZoom>

          {
            d.results.length > 0 && (
              <div class="results">
                {d.results.map((r) => (
                  <div class="result">
                    <b>{r.value}</b>
                    <span>{r.label}</span>
                  </div>
                ))}
              </div>
            )
          }
        </div>

        <aside class="case-aside rev rev-d1" aria-label="Project details">
          <div class="case-fact">
            <b>Client</b>
            <p>{d.client}</p>
          </div>
          <div class="case-fact">
            <b>Year</b>
            <p>{d.year}</p>
          </div>
          {
            d.services.length > 0 && (
              <div class="case-fact">
                <b>Work areas</b>
                <ul>{d.services.map((s) => <li>{s}</li>)}</ul>
              </div>
            )
          }
          {
            d.technologies.length > 0 && (
              <div class="case-fact">
                <b>Tools</b>
                <div>{d.technologies.map((t) => <span class="pill">{t}</span>)}</div>
              </div>
            )
          }
          {
            d.externalUrl && (
              <Button href={d.externalUrl} variant="ink">Visit the site</Button>
            )
          }
        </aside>
      </div>

      <div class="nextprev">
        {next && (
          <a href={`/work/${next.id}/`}>
            <b>Next project</b>
            <span>{next.data.title}</span>
          </a>
        )}
        <a href="/work/">
          <b>Back to projects</b>
          <span>All projects</span>
        </a>
      </div>
    </section>
  </article>

  <Cta />
</BaseLayout>
