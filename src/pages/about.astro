---
import PageLayout from '~/layouts/PageLayout.astro';
import About from '~/components/home/About.astro';
import StatsBand from '~/components/home/StatsBand.astro';
import Toolkit from '~/components/home/Toolkit.astro';
import CvAccordion from '~/components/home/CvAccordion.astro';
import Process from '~/components/home/Process.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { graph, personSchema, breadcrumbSchema } from '~/lib/jsonld';

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Home', url: `${siteConfig.url}/` },
    { name: 'About', url: `${siteConfig.url}/about/` },
  ]),
]);
---

<PageLayout
  title="About"
  heading="Measurement built around the decision."
  eyebrow="About"
  intro={`${siteConfig.author} is a data analyst working across marketing analytics, BI, automation and technical SEO. Based in Milan, Italy.`}
  description={`About ${siteConfig.author} — data analyst working across marketing analytics, BI, automation and technical SEO.`}
  crumbs={[{ label: 'About' }]}
  jsonLd={jsonLd}
>
  <About headingLevel="h2" id="background" />
  <StatsBand />
  <Toolkit />
  <CvAccordion />
  <Process />
  <Cta />
</PageLayout>
