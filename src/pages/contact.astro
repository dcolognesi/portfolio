---
export const prerender = true;
import PageLayout from '~/layouts/PageLayout.astro';
import ContactForm from '~/components/ContactForm.astro';
import Faq from '~/components/home/Faq.astro';
import siteConfig from '~/config/site';
import { faq } from '~/data/faq';
import {
  breadcrumbSchema,
  contactPageSchema,
  faqPageSchema,
  graph,
  personSchema,
} from '~/lib/jsonld';

const contactUrl = `${siteConfig.url}/contact/`;
const contactDescription = `Contact ${siteConfig.author} about analytics, BI, automation and technical SEO.`;

const jsonLd = graph([
  personSchema(siteConfig),
  contactPageSchema(siteConfig, {
    url: contactUrl,
    name: 'Contact',
    description: contactDescription,
  }),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: 'Home', url: `${siteConfig.url}/` },
    { name: 'Contact', url: contactUrl },
  ]),
]);
---

<PageLayout
  title="Contact"
  heading="Get in touch about analytics, BI or technical SEO."
  eyebrow="Contact"
  intro="Share the context, the decision you need to support and any deadline. A short note is enough to start."
  description={contactDescription}
  jsonLd={jsonLd}
  bodyClass="contact-page"
>
  <Fragment slot="header-extra">
    <div class="contact-hero-media">
      <img src="/images/reel-poster.webp" alt="Dario Colognesi showreel" loading="lazy" decoding="async" />
    </div>
  </Fragment>
  <section class="wrap sec contact-section" style="padding-top:0" aria-labelledby="contact-h">
    <div class="contact-grid">
      <div class="rev">
        <h2 class="d3" id="contact-h" style="margin-bottom:24px">Start with the question</h2>
        <p class="lead">
          Tell me what you need to measure, which systems are involved and what decision the
          output should support. Email is the quickest route.
        </p>
        <ContactForm />
      </div>
    </div>
  </section>

  <Faq class="faq-narrow" />
</PageLayout>
