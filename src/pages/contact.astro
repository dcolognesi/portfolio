---
export const prerender = true;
import PageLayout from '~/layouts/PageLayout.astro';
import ContactForm from '~/components/ContactForm.astro';
import Faq from '~/components/home/Faq.astro';
import siteConfig from '~/config/site';
import { faq } from '~/data/faq';
import {
  breadcrumbSchema,
  contactPageSchema,
  faqPageSchema,
  graph,
  personSchema,
} from '~/lib/jsonld';

const contactUrl = `${siteConfig.url}/contact/`;
const contactDescription = `Contact ${siteConfig.author} about analytics, BI, automation and technical SEO.`;

const jsonLd = graph([
  personSchema(siteConfig),
  contactPageSchema(siteConfig, {
    url: contactUrl,
    name: 'Contact',
    description: contactDescription,
  }),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: 'Home', url: `${siteConfig.url}/` },
    { name: 'Contact', url: contactUrl },
  ]),
]);
---

<PageLayout
  title="Contact"
  heading="Get in touch about analytics, Business Intelligence or SEO."
  eyebrow="Contact"
  description={contactDescription}
  jsonLd={jsonLd}
  bodyClass="contact-page"
>
  <Fragment slot="header-extra">
    <div class="contact-hero-media">
      <img src="/images/reel-poster.webp" alt="Dario Colognesi showreel" loading="lazy" decoding="async" />
    </div>
  </Fragment>
  <section class="wrap sec contact-section" style="padding-top:0">
    <div class="contact-grid">
      <div class="rev">
        <p class="lead">
          Tell me what you need to measure, which systems are involved, and what decision the
          output should support. Share the context, the deadline, and what is at stake if the
          problem stays unsolved — a short note is enough to start, and email is the quickest
          route to a concrete next step.
        </p>
        <ContactForm />
      </div>
    </div>
  </section>

  <Faq class="faq-narrow" />
</PageLayout>
