---
import PageLayout from '~/layouts/PageLayout.astro';
import Button from '~/components/Button.astro';
import Icon from '~/components/Icon.astro';
import PhoneReveal from '~/components/PhoneReveal.astro';
import Faq from '~/components/home/Faq.astro';
import siteConfig from '~/config/site';
import { faq } from '~/data/faq';
import {
  breadcrumbSchema,
  contactPageSchema,
  faqPageSchema,
  graph,
  personSchema,
} from '~/lib/jsonld';

const contactUrl = `${siteConfig.url}/contact/`;
const contactDescription = `Contact ${siteConfig.author} about analytics, BI, automation and technical SEO.`;

const jsonLd = graph([
  personSchema(siteConfig),
  contactPageSchema(siteConfig, {
    url: contactUrl,
    name: 'Contact',
    description: contactDescription,
  }),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: 'Home', url: `${siteConfig.url}/` },
    { name: 'Contact', url: contactUrl },
  ]),
]);
---

<PageLayout
  title="Contact"
  heading="Get in touch about analytics, BI or technical SEO."
  eyebrow="Contact"
  intro="Share the context, the decision you need to support and any deadline. A short note is enough to start."
  description={contactDescription}
  crumbs={[{ label: 'Contact' }]}
  jsonLd={jsonLd}
>
  <section class="wrap sec" style="padding-top:0" aria-labelledby="contact-h">
    <div class="contact-grid">
      <div class="rev">
        <h2 class="d3" id="contact-h" style="margin-bottom:24px">Start with the question</h2>
        <p class="lead">
          Tell me what you need to measure, which systems are involved and what decision the
          output should support. Email is the quickest route.
        </p>
        <div style="margin-top:26px">
          <Button href={`mailto:${siteConfig.contact.email}`} variant="ink" icon="mail">
            Email me
          </Button>
        </div>
      </div>

      <div class="contact-aside rev rev-d1">
        <a class="contact-card" href={`mailto:${siteConfig.contact.email}`}>
          <i><Icon name="mail" /></i>
          <div>
            <b>Email</b>
            <span>{siteConfig.contact.email}</span>
          </div>
        </a>
        <div class="contact-card">
          <i><Icon name="phone" /></i>
          <div>
            <b>Phone</b>
            <PhoneReveal />
          </div>
        </div>
        <div class="contact-card">
          <i><Icon name="pin" /></i>
          <div>
            <b>Where</b>
            <span>{siteConfig.contact.location}</span>
          </div>
        </div>
        <div class="contact-card">
          <i><Icon name="spark" /></i>
          <div>
            <b>Availability</b>
            <span>{siteConfig.contact.availability}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Faq />
</PageLayout>
