---
export const prerender = true;
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/home/Hero.astro';
import TrustedStrip from '~/components/home/TrustedStrip.astro';
import Collaborate from '~/components/home/Collaborate.astro';
import StatsBand from '~/components/home/StatsBand.astro';
import Work from '~/components/home/Work.astro';
import Methodology from '~/components/home/Methodology.astro';
import CvAccordion from '~/components/home/CvAccordion.astro';
import Faq from '~/components/home/Faq.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { faq } from '~/data/faq';
import { getCollection } from 'astro:content';
import { isVisible } from '~/lib/utils';
import {
  faqPageSchema,
  graph,
  personSchema,
  profilePageSchema,
  websiteSchema,
  worksItemListSchema,
} from '~/lib/jsonld';

/* Same "featured" filter as Work.astro, so the rendered list and the
   structured data always describe the same Selected Works. */
const featured = (await getCollection('projects'))
  .filter(isVisible)
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const homeUrl = `${siteConfig.url}/`;

const jsonLd = graph([
  personSchema(siteConfig),
  websiteSchema(siteConfig),
  profilePageSchema(
    siteConfig,
    { url: homeUrl, name: siteConfig.title, description: siteConfig.description },
    { hasPart: `${homeUrl}#works` }
  ),
  worksItemListSchema(
    siteConfig,
    featured.map((p) => ({
      title: p.data.title,
      description: p.data.description,
      url: `${siteConfig.url}/work/${p.id}/`,
      image: p.data.image?.src,
      category: p.data.category,
      keywords: [...p.data.services, ...p.data.technologies],
      datePublished: p.data.year,
    }))
  ),
  faqPageSchema(faq),
]);
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
  appendSiteName={false}
  jsonLd={jsonLd}
  bodyClass="home"
>
  <Hero />
  <TrustedStrip />
  <Collaborate />
  <StatsBand />
  <Methodology />
  <Work />
  <CvAccordion />
  <Faq />
  <Cta id="contact" />
</BaseLayout>
