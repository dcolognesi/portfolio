---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/home/Hero.astro';
import TrustedStrip from '~/components/home/TrustedStrip.astro';
import Collaborate from '~/components/home/Collaborate.astro';
import StatsBand from '~/components/home/StatsBand.astro';
import Work from '~/components/home/Work.astro';
import Methodology from '~/components/home/Methodology.astro';
import CvAccordion from '~/components/home/CvAccordion.astro';
import Faq from '~/components/home/Faq.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { faq } from '~/data/faq';
import { faqPageSchema, graph, personSchema, websiteSchema } from '~/lib/jsonld';

const jsonLd = graph([personSchema(siteConfig), websiteSchema(siteConfig), faqPageSchema(faq)]);
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
  appendSiteName={false}
  jsonLd={jsonLd}
  bodyClass="home"
>
  <Hero />
  <TrustedStrip />
  <Collaborate />
  <StatsBand />
  <Methodology />
  <Work />
  <CvAccordion />
  <Faq />
  <Cta id="contact" />
</BaseLayout>
