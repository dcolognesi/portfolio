---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/home/Hero.astro';
import TrustedStrip from '~/components/home/TrustedStrip.astro';
import Collaborate from '~/components/home/Collaborate.astro';
import StatsBand from '~/components/home/StatsBand.astro';
import About from '~/components/home/About.astro';
import Services from '~/components/home/Services.astro';
import Work from '~/components/home/Work.astro';
import Process from '~/components/home/Process.astro';
import CvAccordion from '~/components/home/CvAccordion.astro';
import Journal from '~/components/home/Journal.astro';
import Faq from '~/components/home/Faq.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { graph, personSchema, websiteSchema } from '~/lib/jsonld';

const jsonLd = graph([personSchema(siteConfig), websiteSchema(siteConfig)]);
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
  appendSiteName={false}
  jsonLd={jsonLd}
>
  <Hero />
  <TrustedStrip />
  <Collaborate />
  <StatsBand />
  <About />
  <Services />
  <Work />
  <Process />
  <CvAccordion />
  <Journal />
  <Faq />
  <Cta id="contact" />
</BaseLayout>
