---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
---

<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <section class="wrap nf">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1 class="d2">This page is not here.</h1>
    <p>
      The link may be broken or the page may have moved. Projects, skills and contact details
      are still available.
    </p>
    <div class="nf-actions">
      <Button href="/" variant="ink">Back to the homepage</Button>
      <Button href="/work/" variant="lime">View projects</Button>
    </div>
  </section>
</BaseLayout>
