# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
# Lines starting with # are comments. A comment line must precede a rule.

# Global security headers. No Content-Security-Policy is set on purpose:
# the site relies on inline scripts (reveal/nav) and inline JSON-LD, so a
# strict CSP would break them. Add one with nonces if you remove inline JS.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin

# Hashed build assets: safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts: filenames are not content-hashed, so bump a query
# string (e.g. /fonts/inter-tight-latin.woff2?v=2) whenever the file changes.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images change rarely; one week keeps re-deploys visible quickly.
/images/*
  Cache-Control: public, max-age=604800

# The 404 page is served for any unknown URL: keep it out of the index.
/404/*
  X-Robots-Tag: noindex
